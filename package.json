{
  "name": "bioplot",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Planner for Chainers Farm: read your seeds, plots and animals, then see exactly what to plant for the most biopoints in 24 hours.",
  "license": "MIT",
  "homepage": "https://github.com/develoverli/bioplot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/develoverli/bioplot.git"
  },
  "bugs": {
    "url": "https://github.com/develoverli/bioplot/issues"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "vite",
    "build": "python scripts/build-legal.py && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "data:refresh": "python scripts/extract-docs.py && python scripts/build-extension-data.py",
    "legal": "python scripts/build-legal.py",
    "icons": "python scripts/make-icons.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
