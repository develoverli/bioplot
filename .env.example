# Where the published extension lives. Leave empty until it is actually published: the app
# then shows the "load unpacked" steps instead of linking somewhere that does not exist.
#
# Chrome Web Store, once approved:
#   VITE_EXTENSION_URL=https://chromewebstore.google.com/detail/<your-extension-id>
VITE_EXTENSION_URL=

# The app's own public origin. Only needed where a link has to be absolute; the policy pages
# are served from here, so this is also the address the store listing points at.
#   VITE_SITE_URL=https://bioplot.example
VITE_SITE_URL=
